{
  "manifest_version": 3,
  "name": "XoraPass Zero-Knowledge Vault",
  "version": "1.2.0",
  "description": "Zero-knowledge autofill companion for XoraPass.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "alarms",
    "idle",
    "offscreen",
    "clipboardWrite",
    "contextMenus",
    "management"
  ],
  "optional_permissions": [
    "downloads",
    "cookies",
    "declarativeNetRequest"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "host_permissions": [
    "https://app.xorapass.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "addon@xorapass.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["personallyIdentifyingInfo", "authenticationInfo", "browsingActivity", "websiteContent", "personalCommunications"]
      }
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["shieldNav.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["pageHooks.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "match_origin_as_fallback": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["cardFrame.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["xorapass_logo_horizontal.png", "xorapass_logo_mark.png", "icons/icon16.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://app.xorapass.com/*"
    ]
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Open XoraPass Vault Popup"
    },
    "autofill-active": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Autofill credentials on active page"
    },
    "generate-password": {
      "suggested_key": {
        "default": "Ctrl+Shift+G",
        "mac": "Command+Shift+G"
      },
      "description": "Generate and copy new strong password"
    }
  }
}
