{
  "manifest_version": 3,
  "name": "XoraPass Zero-Knowledge Vault",
  "version": "1.0.1",
  "description": "Zero-knowledge autofill companion for XoraPass.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "alarms",
    "offscreen",
    "clipboardWrite",
    "notifications"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "host_permissions": [
    "https://app.xorapass.com/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "addon@xorapass.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["xorapass_logo_horizontal.png", "xorapass_logo_mark.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "externally_connectable": {
    "ids": ["*"],
    "matches": [
      "https://app.xorapass.com/*",
      "http://localhost:3000/*"
    ]
  }
}
